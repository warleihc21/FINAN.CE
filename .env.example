# Modelo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env

# Modo debug (True em desenvolvimento, False em produção)
DEBUG=True

# Configurações de e-mail (Gmail / SMTP)
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
